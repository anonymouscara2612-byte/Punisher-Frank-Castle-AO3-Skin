}

.favorite.module.odd h3.heading,
.latest.news.module h3.heading span.title,
.random.readings.module h3.heading span.title,
.latest.messages.module h3.heading span.title,
.social.module h3.heading {
  color: #E1DFD7;
  font-variant: small-caps;
}

.latest.news.module h3.heading,
.latest.messages.module.odd h3.heading {
  border-bottom: none;
  background: rgba(13, 13, 12, 0.7);
  border-radius: 10px;
}

div.favorite.module {
  padding: 10px;
  box-sizing: border-box;
  border-radius: 10px;
  background: rgba(13, 13, 12, 0.7);
  box-shadow: none;
}

.splash .favorite li:nth-of-type(2n+1) a,
.splash .favorite li:nth-of-type(2n+2) a {
  background: rgba(13, 13, 12, 0.5);
  border-radius: 10px;
  color: #E1DFD7;
}

.splash .favorite li:nth-of-type(2n+1) a::before,
.splash .favorite li:nth-of-type(2n+2) a::before {
  content: " 💀 ";
  color: transparent !important;
  text-shadow: 0 0 0 #E1DFD7;
}

.splash .favorite li:nth-of-type(2n+1) a:hover,
.splash .favorite li:nth-of-type(2n+2) a:hover {
  background: #0D0D0C;
  color: #E4CECE !important;
}

.splash .favorite li:nth-of-type(2n+1) a:hover::before,
.splash .favorite li:nth-of-type(2n+2) a:hover::before {
  content: " 🗡️ ";
  color: transparent !important;
  text-shadow: 0 0 0 #E4CECE;
}

.splash .favorite {
  position: relative;
  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 80px;
  height: 100px;
  background-image: url("https://64.media.tumblr.com/99062b28bc2c6d9486bd14a5fe918a6b/bc24136492b10822-e8/s500x750/ae5f04f4246716a74907f56204e0f5e2fa320e8e.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: "ᴏɴᴇ ʙᴀᴛᴄʜ, ᴛᴡᴏ ʙᴀᴛᴄʜ, ᴩᴇɴɴy ᴀɴᴅ ᴅɪᴍᴇ…";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(20px);
  border-radius: 10px;
  background: rgba(13, 13, 12, 0.7);
  text-align: center;
  font-size: 14px;
  color: #E1DFD7;
  opacity: 1;
  white-space: pre;
}

.news.index.group li.post.group {
